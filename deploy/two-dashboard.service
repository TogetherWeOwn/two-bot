# The growth dashboard, served as a page instead of a file somebody has to
# remember to regenerate.
#
#   sudo cp deploy/two-dashboard.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now two-dashboard
#   curl -s localhost:8099 | head       # smoke test on the box
#
# It binds to 127.0.0.1 on purpose. To make it reachable, put it behind the
# host's existing reverse proxy WITH authentication - this page shows member
# counts and channel names and is not for the public. Do not change the bind
# address to 0.0.0.0 as a shortcut.
#
# Read-only: it opens the bot's database, runs SELECTs, closes. It cannot write.

[Unit]
Description=TWO growth dashboard
Documentation=https://github.com/TogetherWeOwn/two-bot/blob/main/docs/DASHBOARD.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=twobot
Group=twobot
WorkingDirectory=/opt/two-bot
Environment=PORT=8099
EnvironmentFile=/etc/two-bot/two-bot.env
ExecStart=/usr/bin/node scripts/dashboard.ts --serve --host 127.0.0.1

Restart=always
RestartSec=10
StartLimitIntervalSec=300
StartLimitBurst=10

KillSignal=SIGTERM
TimeoutStopSec=10

StandardOutput=journal
StandardError=journal
SyslogIdentifier=two-dashboard

# Hardening. It needs the network (to listen) and read access to its own data
# directory. It never needs to write anything - ProtectSystem=strict with no
# ReadWritePaths keeps /opt/two-bot read-only, so a compromised render path
# cannot plant a file the bot would later read.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictNamespaces=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
UMask=0077
# Empty set: serving a page needs no capability.
CapabilityBoundingSet=
AmbientCapabilities=
# Co-tenancy: hide other services' processes; a dashboard never inspects /proc.
ProtectProc=invisible
ProcSubset=pid
# Listen socket + loopback Postgres. A compromised dependency cannot open a raw socket.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @obsolete
SystemCallArchitectures=native
# Read-only and low-priority: half a core, 256M.
MemoryMax=256M
CPUQuota=50%
TasksMax=32

[Install]
WantedBy=multi-user.target
