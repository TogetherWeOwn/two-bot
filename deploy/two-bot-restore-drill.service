# Monthly restore drill, paired with two-bot-restore-drill.timer.
#
#   sudo cp deploy/two-bot-restore-drill.{service,timer} /etc/systemd/system/
#   sudo systemctl enable --now two-bot-restore-drill.timer
#   sudo systemctl start two-bot-restore-drill      # run one now
#
# Restores the newest backup into the scratch database and checks the row
# counts against the dump's own manifest. It exists because a backup nobody has
# restored is a hypothesis, not a backup - and the way that fails is silent:
# the nightly job goes green for six months and the file turns out to be
# unreadable on the day it matters.
#
# This unit fails loudly. A red drill means the backups are not real, and it is
# better to find that out on the 1st of the month than during an outage.
#
# TWO_RESTORE_URL must point at the SCRATCH database, never production. It is a
# separate variable from TWO_DATABASE_URL for exactly that reason - see the note
# in scripts/pg-restore.ts.

[Unit]
Description=Prove the TWO bot backups can actually be restored
After=two-bot-backup.service

[Service]
Type=oneshot
User=twobot
Group=twobot
WorkingDirectory=/opt/two-bot

# TWO_RESTORE_URL=postgres://.../two_scratch
EnvironmentFile=/etc/two-bot/backup.env

# Newest backup in the directory. `set -o pipefail` so an empty directory fails
# the unit rather than running a restore against an empty path.
ExecStart=/usr/bin/bash -o pipefail -c '\
  latest=$(ls -1t /var/backups/two-bot/two-funnel-*.ndjson.gz | head -1); \
  echo "drill: restoring $latest into the scratch database"; \
  exec /usr/bin/node /opt/two-bot/scripts/pg-restore.ts "$latest" --force'

StandardOutput=journal
StandardError=journal
SyslogIdentifier=two-bot-restore-drill

# Same posture as the backup job: Postgres only, one read path for the dump
# files. No Restart=: timer-started oneshots must stay failed when they fail so
# a red drill is visible instead of looping.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
# Read-only: the drill reads the newest dump and writes to the scratch database
# over the network. It must never modify the backup directory.
ReadOnlyPaths=/var/backups/two-bot
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictNamespaces=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
UMask=0077
CapabilityBoundingSet=
AmbientCapabilities=
# Co-tenancy: hide other services' processes; a drill never inspects /proc.
ProtectProc=invisible
ProcSubset=pid
# Postgres only. A compromised dependency cannot open a raw socket.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @obsolete
SystemCallArchitectures=native
# Monthly and low-priority: half a core, 512M (restore buffers in memory).
MemoryMax=512M
CPUQuota=50%
TasksMax=32
