# Nightly backup, paired with two-bot-backup.timer.
#
#   sudo cp deploy/two-bot-backup.{service,timer} /etc/systemd/system/
#   sudo systemctl enable --now two-bot-backup.timer
#   systemctl list-timers two-bot-backup
#
# Backs up Postgres using the bot's verified NDJSON dump format.
#
# Note this unit does NOT get the Discord token. A backup needs the database and
# nothing else, which is why the connection string lives in its own environment
# file rather than in the bot's.

[Unit]
Description=Back up the TWO bot funnel log
After=two-bot.service

[Service]
Type=oneshot
User=twobot
Group=twobot
WorkingDirectory=/opt/two-bot

# TWO_DATABASE_URL, TWO_BACKUP_UPLOAD_CMD, and whatever credentials that upload
# command needs. Root-owned, chmod 600. See docs/RUNBOOK.md.
EnvironmentFile=/etc/two-bot/backup.env
Environment=TWO_BACKUP_DIR=/var/backups/two-bot
Environment=TWO_BACKUP_KEEP=14
ExecStart=/usr/bin/node /opt/two-bot/scripts/pg-backup.ts

StandardOutput=journal
StandardError=journal
SyslogIdentifier=two-bot-backup

# Same posture as the bot: this writes to one directory and talks to Postgres
# (plus HTTPS to R2 on upload). Nothing else. Timer-started oneshots carry no
# Restart=: the timer refires nightly, and a failed run must stay failed so the
# failure is visible instead of looping.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/backups/two-bot
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictNamespaces=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
UMask=0077
CapabilityBoundingSet=
AmbientCapabilities=
# Co-tenancy: hide other services' processes; a backup never inspects /proc.
ProtectProc=invisible
ProcSubset=pid
# Postgres + HTTPS upload only. A compromised dependency cannot open a raw socket.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @obsolete
SystemCallArchitectures=native
# Nightly and low-priority: half a core, 512M (the dump streams via pipeline).
MemoryMax=512M
CPUQuota=50%
TasksMax=32
