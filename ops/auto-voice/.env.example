# Auto-Voice-Channels (AVC) — Coolify environment for the LIVE TWO guild. TOG-3052.
#
# These are the variables `ops/auto-voice/docker-compose.yml` reads. Set them on
# the Coolify application, not in a file on the host: the compose file has no
# `env_file`, deliberately, so there is no `.env` on disk holding a bot token.
#
# Values shown here are the real non-secret ones. The two marked SECRET must be
# created as Coolify secrets and never pasted into a card, comment, or log.

# --- Required ---------------------------------------------------------------

# SECRET. Paperclip secret `AVC_DISCORD_BOT_TOKEN` (description prefix `3ef28715…`).
# Discord application 1549879082085515364 ("Auto-Voice"). This is a DIFFERENT
# application from Owen — do not reuse Owen's DISCORD_BOT_TOKEN here.
AVC_DISCORD_BOT_TOKEN=

# SECRET. New value, generated on the host, not reused from anything:
#   openssl rand -base64 32
# Upstream's self-host default is `postgres`/`postgres`; this container is on a
# shared VPS, so it gets its own password.
AVC_POSTGRES_PASSWORD=

# Public application id of the Auto-Voice bot. Not a secret.
AVC_CLIENT_ID=1549879082085515364

# --- Pinning ----------------------------------------------------------------
# Both default correctly in docker-compose.yml; set them only to move the pin,
# and move BOTH together or /health will report a commit that is not what ran.

# AVC_GIT_CONTEXT=https://github.com/GregZaal/Auto-Voice-Channels.git#8fab5e8d78aa252195dcea1bcd3d313cb1ba0802
# AVC_GIT_COMMIT=8fab5e8d78aa252195dcea1bcd3d313cb1ba0802

# --- Worth setting before live activation -----------------------------------

# A text channel id AVC posts unhandled errors to. Without it they reach only
# the container log. This is the ONLY way a permissions failure on Squad — the
# most likely failure here — becomes visible to a human. Recommend the existing
# staff alert channel.
AVC_ADMIN_CHANNEL_ID=

# Heartbeat/push monitor URL. MUST be a heartbeat or push check (Uptime Kuma,
# healthchecks.io, Better Stack), NOT a chat webhook: a webhook answers a GET
# without posting anything, so the monitor stays green forever and no message
# ever arrives.
AVC_WATCHDOG_PING_URL=

# Guards GET /diagnostics (shard topology + every runtime flag). Minimum 16
# characters. Nothing is published to the host, so this is defence in depth.
AVC_DIAGNOSTICS_TOKEN=

# trace | debug | info | warn | error | fatal | silent
AVC_LOG_LEVEL=info

# --- Discord status patch (TOG-3143) ----------------------------------------
# Read by ops/auto-voice/status-patch.sh, not by upstream. See README.md §3.1.

# The bot's Discord status. `/setup` is a PLACEHOLDER that strips upstream's
# `auto-voice.io · /setup` advert; the final text is the owner's pick on
# TOG-3142, applied here with a restart and no rebuild. Set it to the EMPTY
# STRING to disable the patch and run upstream verbatim (README.md §1.1).
AVC_STATUS_TEXT=/setup

# strict = refuse to start if the patch cannot find its anchor (only possible if
# the upstream pin moved). warn = log and start with upstream's advert instead.
# Leave it strict; `warn` is the hatch for an operator who needs the bot up now.
AVC_STATUS_ENFORCE=strict

# Host path of the script to mount. The default is correct when Compose takes its
# project directory from the compose file (the normal case). Set it to
# ./ops/auto-voice/status-patch.sh only if the container crash-loops with
# "can't open /opt/avc/status-patch.sh" — README.md §8 has the diagnosis.
# AVC_STATUS_PATCH_PATH=./status-patch.sh
