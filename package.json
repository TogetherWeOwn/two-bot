{
  "name": "two-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "TWO gaming community Discord bot and funnel instrumentation",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/index.ts",
    "dev": "node --env-file=.env src/index.ts",
    "test": "node --test test/*.test.ts",
    "test:unit": "node --test test/unit.*.test.ts",
    "test:e2e": "node --test test/e2e.*.test.ts",
    "test:postgres": "node scripts/require-suites.ts",
    "test:restart-storage": "node scripts/require-restart-storage.ts",
    "typecheck": "tsc --noEmit",
    "funnel": "node scripts/funnel.ts",
    "gate": "node scripts/gate-report.ts",
    "gate:timeout": "node scripts/rules-gate-timeout.ts",
    "redirect": "node scripts/redirect.ts",
    "campaigns": "node scripts/campaigns.ts",
    "voice": "node scripts/voice-sessions.ts",
    "attribution": "node scripts/attribution.ts",
    "eval:funnel-attribution": "node scripts/funnel-attribution-eval.ts",
    "gate:check": "node scripts/gate-check.ts",
    "review": "node scripts/growth-review.ts",
    "dashboard": "node scripts/dashboard.ts",
    "roster": "node scripts/roster.ts",
    "audit:collect": "node scripts/audit-collect.ts",
    "audit:halt": "node scripts/audit-switch.ts --halt",
    "audit:resume": "node scripts/audit-switch.ts --resume",
    "audit:switch": "node scripts/audit-switch.ts --status",
    "wave0": "node scripts/wave0-export.ts",
    "wave2": "node scripts/wave2-additive.ts",
    "wave6:hierarchy": "node scripts/wave6-hierarchy-check.ts",
    "reengage": "node scripts/reengagement.ts",
    "backfill": "node scripts/backfill.ts",
    "capture": "node scripts/capture.ts",
    "backfill:messages": "node scripts/backfill-messages.ts",
    "reconcile": "node scripts/reconcile.ts",
    "preflight": "node scripts/preflight.ts",
    "verify:grant": "node scripts/verify-grant.ts",
    "verify:grant:selftest": "node scripts/verify-grant.ts --selftest",
    "check:snowflakes": "bash scripts/ci/check-src-snowflakes.sh",
    "check:snowflakes:selftest": "bash scripts/ci/check-src-snowflakes.test.sh",
    "backup": "node scripts/pg-backup.ts",
    "verify:catalog": "node scripts/verify-catalog.ts",
    "event:sunday-squad": "node scripts/sunday-squad-event.ts",
    "moderation:disable-preflight": "node scripts/moderation-disable-preflight.ts",
    "staging:doctor": "node scripts/staging-doctor.ts",
    "staging:reset": "node scripts/staging-reset.ts",
    "staging:check": "node scripts/staging-reset.ts --check",
    "staging:verify": "node scripts/staging-verify.ts",
    "staging:anti-nuke": "node scripts/staging-anti-nuke-acceptance.ts",
    "staging:provision": "node scripts/staging-provision.ts",
    "self-role:panel": "node scripts/self-role-panel.ts",
    "hooks:install": "bash scripts/install-hooks.sh",
    "prepare": "bash scripts/install-hooks.sh >/dev/null 2>&1 || true",
    "migrate": "node scripts/migrate.ts",
    "backup:pg": "node scripts/pg-backup.ts",
    "backup:guild-config": "node scripts/guild-config-snapshot.ts",
    "restore:pg": "node scripts/pg-restore.ts",
    "restore:guild-config": "node scripts/guild-config-restore.ts",
    "web:views": "node scripts/web-views.ts",
    "web:role": "node scripts/provision-web-role.ts",
    "verify:web-role": "node scripts/verify-web-role.ts",
    "presence:trend": "node scripts/presence-trend.ts",
    "levels:import:mee6": "node scripts/levels-import-mee6.ts",
    "levels:inventory": "node scripts/levels-import-mee6.ts inventory",
    "levels:roles": "node scripts/levels-role-rewards.ts",
    "levels:roles:probe": "node scripts/levels-import-rewards-probe.ts",
    "onboarding:web:acceptance": "node scripts/onboarding-web-slice-acceptance.ts",
    "automod:export": "node scripts/automod-export.ts",
    "community:scorecard": "node scripts/community-scorecard.ts"
  },
  "dependencies": {
    "@discordjs/collection": "2.1.1",
    "@discordjs/ws": "1.2.3",
    "discord.js": "^14.27.0",
    "fast-xml-parser": "^5.11.1",
    "pg": "^8.23.0",
    "undici": "^6.28.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.5.0",
    "typescript": "^5.9.3",
    "ws": "^8.21.0"
  }
}
