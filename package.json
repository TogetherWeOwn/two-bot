{
  "name": "two-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "TWO gaming community Discord bot and funnel instrumentation",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/index.ts",
    "dev": "node --env-file=.env src/index.ts",
    "test": "node --test test/unit.store.test.ts test/unit.backfill.test.ts test/unit.onboarding.test.ts test/unit.staging.test.ts test/e2e.funnel.test.ts test/e2e.onboarding.test.ts",
    "test:unit": "node --test test/unit.store.test.ts test/unit.backfill.test.ts test/unit.onboarding.test.ts test/unit.staging.test.ts",
    "test:e2e": "node --test test/e2e.funnel.test.ts test/e2e.onboarding.test.ts",
    "typecheck": "tsc --noEmit",
    "funnel": "node scripts/funnel.ts",
    "backfill": "node scripts/backfill.ts",
    "preflight": "node scripts/preflight.ts",
    "backup": "bash scripts/backup.sh",
    "verify:catalog": "node scripts/verify-catalog.ts"
  },
  "dependencies": {
    "@types/pg": "^8.23.1",
    "discord.js": "^14.27.0",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/ws": "^8.5.0",
    "typescript": "^5.9.3",
    "ws": "^8.21.0"
  }
}
