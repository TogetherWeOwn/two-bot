{
  "name": "two-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "TWO gaming community Discord bot and funnel instrumentation",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/index.ts",
    "dev": "node --env-file=.env src/index.ts",
    "test": "node --test test/*.test.ts",
    "test:unit": "node --test test/unit.*.test.ts",
    "test:e2e": "node --test test/e2e.*.test.ts",
    "test:postgres": "node scripts/require-suites.ts",
    "typecheck": "tsc --noEmit",
    "funnel": "node scripts/funnel.ts",
    "redirect": "node scripts/redirect.ts",
    "campaigns": "node scripts/campaigns.ts",
    "voice": "node scripts/voice-sessions.ts",
    "attribution": "node scripts/attribution.ts",
    "dashboard": "node scripts/dashboard.ts",
    "roster": "node scripts/roster.ts",
    "audit:collect": "node scripts/audit-collect.ts",
    "wave0": "node scripts/wave0-export.ts",
    "reengage": "node scripts/reengagement.ts",
    "backfill": "node scripts/backfill.ts",
    "capture": "node scripts/capture.ts",
    "backfill:messages": "node scripts/backfill-messages.ts",
    "reconcile": "node scripts/reconcile.ts",
    "preflight": "node scripts/preflight.ts",
    "backup": "bash scripts/backup.sh",
    "verify:catalog": "node scripts/verify-catalog.ts",
    "staging:doctor": "node scripts/staging-doctor.ts",
    "staging:reset": "node scripts/staging-reset.ts",
    "staging:check": "node scripts/staging-reset.ts --check",
    "staging:verify": "node scripts/staging-verify.ts",
    "staging:provision": "node scripts/staging-provision.ts",
    "hooks:install": "bash scripts/install-hooks.sh",
    "prepare": "bash scripts/install-hooks.sh >/dev/null 2>&1 || true",
    "migrate": "node scripts/migrate.ts",
    "migrate:data": "node scripts/migrate-sqlite-to-postgres.ts",
    "backup:pg": "node scripts/pg-backup.ts",
    "restore:pg": "node scripts/pg-restore.ts",
    "web:views": "node scripts/web-views.ts",
    "web:role": "node scripts/provision-web-role.ts",
    "verify:web-role": "node scripts/verify-web-role.ts",
    "presence:trend": "node scripts/presence-trend.ts"
  },
  "dependencies": {
    "discord.js": "^14.27.0",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.5.0",
    "typescript": "^5.9.3",
    "ws": "^8.21.0"
  }
}
