# Copy to .env and fill in. .env is gitignored - never commit a real token.
# Production reads these from /etc/two-bot/two-bot.env instead. See docs/SECRETS.md.

# Bot token from the Discord developer application. REQUIRED.
# DISCORD_BOT_TOKEN is what the hosting environment provisions; DISCORD_TOKEN
# is accepted as an alias so older local .env files keep working.
#
# LOCAL DEVELOPMENT ONLY. In production the token is NOT an environment
# variable and does NOT go in /etc/two-bot/two-bot.env - it is a systemd
# credential file, /etc/two-bot/credentials/discord_token, because the box is
# shared with the website. bootstrap-host.sh refuses to deploy (exit 6) if it
# finds this key set in the production env file.
DISCORD_BOT_TOKEN=

# Optional: restrict the bot to a single server.
DISCORD_GUILD_ID=

# Custom commands, schedules, and stickies are default-off and staging-only in
# this release. TWO_AUTOMATIONS=1 is refused unless DISCORD_GUILD_ID is the
# coded TWO Staging guild; live rollout requires a separate reviewed change.
TWO_AUTOMATIONS=
# Text-trigger custom commands remain independently opt-in.
TWO_TEXT_COMMANDS=
# Enables signed internal-action import/export only while automations are on.
TWO_INTERNAL_ALLOW_AUTOMATIONS=
# Overwriting existing commands requires this second internal-action opt-in.
TWO_INTERNAL_ALLOW_AUTOMATIONS_OVERWRITE=

# Moderation is off unless explicitly enabled. Build and prove this only in the
# TWO Staging guild before any separate live-rollout approval. Owen and every
# role listed below are protected from target actions; all bots and the guild
# owner are protected in code as well.
TWO_MODERATION=
TWO_OWEN_USER_ID=
TWO_MODERATION_PROTECTED_ROLE_IDS=
# Enables the same moderation verbs on the signed internal-actions endpoint.
TWO_INTERNAL_ALLOW_MODERATION=

# Automod is off by default and requires moderation above. Message content is
# inspected in memory only; it is never stored or logged. Start with dry-run in
# TWO Staging, then remove dry-run only for the staged trigger corpus.
TWO_AUTOMOD=
# Destructive enforcement requires this separate explicit opt-in.
TWO_AUTOMOD_ENFORCE=
TWO_AUTOMOD_BAD_WORDS=
TWO_AUTOMOD_REPEAT_COUNT=3
TWO_AUTOMOD_REPEAT_WINDOW_SECONDS=30
TWO_AUTOMOD_MENTION_LIMIT=5
TWO_AUTOMOD_ALLOWED_DOMAINS=two.gg,togetherweown.com
TWO_AUTOMOD_BLOCKED_ATTACHMENT_EXTENSIONS=bat,cmd,com,exe,js,jse,msi,ps1,scr,vbs,wsf
TWO_AUTOMOD_BYPASS_ROLE_IDS=
TWO_AUTOMOD_EXEMPT_CHANNEL_IDS=
# threshold:action[:timeout_seconds], ordered by threshold.
TWO_AUTOMOD_SANCTIONS=1:delete,2:warn,3:timeout:600

# Anti-nuke containment. Off by default and scoped to DISCORD_GUILD_ID. The
# detector consumes authoritative Discord audit entries, adds destructive heat
# per executor, strips only dangerous roles below Owen, and posts a staff alert.

# Event RSVP, raid/LFG role-slot posts, and RSS/YouTube/Twitch feed relays.
# Staging-only and default-off until the owner-gated live rollout.
TWO_ANNOUNCEMENTS=
# Poll interval for configured feeds, 60-86400 seconds (default 300).
TWO_FEED_POLL_SECONDS=300

# Start staging in dry-run mode. Never put the live guild or token into the
# staging variables. Join risk is always flag-only; it never kicks or bans.
TWO_ANTI_NUKE=
# Omit/1 = dry run. Only the explicit value 0 permits role removals.
TWO_ANTI_NUKE_DRY_RUN=1
TWO_ANTI_NUKE_WINDOW_SECONDS=60
TWO_ANTI_NUKE_HEAT_THRESHOLD=5
TWO_ANTI_NUKE_EVENT_MAX_AGE_SECONDS=120
TWO_ANTI_NUKE_PROTECTED_USER_IDS=
TWO_ANTI_NUKE_TRUSTED_USER_IDS=
# Accepted guild-config snapshot used only to calculate a guarded restore plan.
# The gateway handler does not auto-apply the plan.
TWO_ANTI_NUKE_SNAPSHOT_PATH=
# ISO-8601 end time for an owner-initiated purchased-member join window. While
# active, join-risk rows are still recorded but no member is flagged.
TWO_BULK_JOIN_WINDOW_UNTIL=
TWO_JOIN_RISK_WINDOW_SECONDS=60
TWO_JOIN_RISK_THRESHOLD=5

# Onboarding (TWO-7). Comma-separated channel ids where the welcome + game
# picker is posted. If this is empty, onboarding does not run at all - the bot
# will never guess a channel to post into. See docs/ROUTING.md.
DISCORD_LANDING_CHANNEL_IDS=

# The routed Sunday Squad welcome (TOG-93 / TWO-66 §5.3). Set this to the text
# chat of the voice room the anchor event runs in - 1175127344072118405, the
# 🔊🏠〢Lobby - and the rules-gate-clear moment produces one message naming the
# next Sunday Squad, in the room the member arrived in.
#
# Setting it MOVES that moment: the game picker's own welcome post stops, because
# onboarding_prompted is once-per-member and two greetings would starve each
# other. The picker itself keeps working. Unset = the pre-TOG-93 behaviour.
DISCORD_ANCHOR_WELCOME_CHANNEL_ID=

# Roleless session routing. `session` requires DISCORD_GUILD_ID and both
# destination channel ids below. Every handler rejects events from other guilds,
# role.assign is removed from the internal-actions allowlist, leveling stops
# applying reward roles, and startup refuses both a non-empty
# TWO_SELF_ROLE_PANELS catalogue and an armed TWO_ANTI_NUKE - its quarantine
# removes member roles. TWO_ANTI_NUKE_DRY_RUN=1 (alerts only) is still allowed.
TWO_ONBOARDING_MODE=legacy
DISCORD_GOODBYE_CHANNEL_IDS=
DISCORD_SESSION_LOOKING_TO_PLAY_CHANNEL_ID=
DISCORD_SESSION_LOBBY_VOICE_CHANNEL_ID=

# Optional: set to 1 to run onboarding without granting any roles. The picker
# still appears and the funnel still records, but nothing is changed on the
# server. Useful for a first look on a live server.
TWO_ONBOARDING_DRY_RUN=

# Hardened self-role panels (TOG-1646). JSON array; empty disables the feature.
# Every panel is bound to an exact channel/message pair so copied custom ids or
# reactions on another message are rejected. Role ids must already exist, sit
# below the bot, and carry only explicitly member-safe permissions: AddReactions,
# Stream, ViewChannel, SendMessages, EmbedLinks, AttachFiles, ReadMessageHistory,
# UseExternalEmojis, Connect, Speak, ChangeNickname, or UseApplicationCommands.
# Every other known or future Discord permission bit fails closed. Every option
# must also pin the role's exact current decimal `permissions` bitfield. Startup
# verifies that the live mask still matches; every dispatch re-checks the
# allowlist immediately before mutation. `color:true` requires an exclusive panel.
#
# Example (fake ids; the role has no guild permissions):
# TWO_SELF_ROLE_PANELS='[{"id":"games","channelId":"111111111111111111","messageId":"222222222222222222","mode":"select","exclusive":false,"color":false,"options":[{"key":"test","label":"Game: Test","roleId":"333333333333333333","permissions":"0","emoji":"🎮"}]}]'
TWO_SELF_ROLE_PANELS=
# Optional: set to 1 to audit valid self-role requests without changing roles.
# Independent of TWO_ONBOARDING_DRY_RUN in legacy mode. Session mode refuses a
# non-empty catalogue so its zero-role-write guarantee cannot be bypassed.
TWO_SELF_ROLE_DRY_RUN=

# Join-burst alerts (TWO-56). A STAFF channel id - the alert lists member ids,
# so it must not be a channel members can read. Empty means the detector still
# runs and the alert goes to the process log only, which nobody is watching at
# 21:16 on a Monday. See docs/RAID-RESPONSE.md.
DISCORD_STAFF_ALERT_CHANNEL_ID=1138590808715571300

# Optional: what counts as a burst. Defaults are 5 joins in 60 seconds, which
# fires on all three raids in this server's history and on no other day in nine
# years. Check any change with `node scripts/raid-list.ts --scan`.
TWO_RAID_JOIN_THRESHOLD=5
TWO_RAID_WINDOW_SECONDS=60

# Metadata-only staff logging. Each value is an explicit staff-only channel id;
# empty means the durable table and process log still receive the event, but no
# Discord message is posted. Never point these at member-facing channels.
DISCORD_AUDIT_LOG_CHANNEL_ID=
DISCORD_VOICE_LOG_CHANNEL_ID=
DISCORD_MODERATION_LOG_CHANNEL_ID=

# Tickets. All three ids are required before the ticket feature starts; this keeps
# an incomplete setup from guessing where to create private channels. Discord's
# privileged Message Content intent must also be enabled for complete transcripts.
# Ticket transcripts are automatically purged 90 days after close.
DISCORD_TICKET_CATEGORY_ID=
DISCORD_TICKET_STAFF_ROLE_ID=
DISCORD_TICKET_PANEL_CHANNEL_ID=
TWO_TICKET_COOLDOWN_SECONDS=300

# Postgres connection string for the funnel log. REQUIRED in production.
# Contains a password - never commit it, never paste it into an issue.
#
# Deliberately NOT called DATABASE_URL: plenty of hosts inject one of their own,
# and silently writing the funnel log into somebody else's database is not a
# failure mode worth having.
TWO_DATABASE_URL=

# Optional: connections in the pool. Default 5, which is plenty for the bot.
# Raise only if you actually see connection waits. See docs/STACK.md.
TWO_DB_POOL_MAX=5

# REQUIRED for database-backed tests. Tests create and drop isolated schemas
# inside this database. CI supplies its own throwaway Postgres service.
# TWO_TEST_DATABASE_URL=postgres://localhost:5432/two_bot_test

# Optional: days of silence before a member is flagged inactive.
TWO_INACTIVITY_DAYS=14

# Human-only weekly Community Platform scorecard. Default-off until its streams,
# channel scopes and classifier exclusions are configured. It runs Monday 06:15
# UTC for the prior closed ISO week. Recommendations can be killed independently
# while raw validated reports continue.
TWO_COMMUNITY_SCORECARD=
TWO_COMMUNITY_RECOMMENDATIONS=1
TWO_COMMUNITY_CORRECTION_CYCLES=0
TWO_COMMUNITY_CLASSIFIER_VERSION=community-v1
TWO_COMMUNITY_HUMAN_CHANNEL_IDS=
TWO_COMMUNITY_WELCOME_CHANNEL_IDS=
TWO_COMMUNITY_AUTOMATION_ACTOR_IDS=
TWO_COMMUNITY_RAID_ACTOR_IDS=
TWO_COMMUNITY_STAGING_GUILD_IDS=
TWO_COMMUNITY_STAGING_ACTOR_IDS=
TWO_COMMUNITY_TEST_ACTOR_IDS=

# Optional: debug | info | error
LOG_LEVEL=info

# --- health endpoint (containers) -------------------------------------------
# Unset means no health server and no open port, which is what the systemd
# deployment wants. The container image sets this to 8080 because Coolify
# decides whether a deploy succeeded by polling it. See docs/DEPLOY.md.
#
#   GET /healthz  liveness  - process is up. Restart probe.
#   GET /readyz   readiness - gateway connected AND database answering.
#                             Deploy gate. 503 + a reason when not.
# TWO_HEALTH_PORT=8080
#
# Defaults to 0.0.0.0: the probe comes from outside the container. Set it to
# 127.0.0.1 if you run the bot directly on a host and want it unreachable.
# TWO_HEALTH_BIND_HOST=0.0.0.0

# TESTING ONLY. Points discord.js at tools/mock-discord instead of Discord.
# Must be unset in production.
# DISCORD_API_BASE=

# --- staging (QA integration tests) -----------------------------------------
# Deliberately DIFFERENT names from the live variables above. The reset script
# refuses to run unless these are set, so a staging run can never inherit the
# live connection string or the live guild by accident. See docs/STAGING.md.
#
# The "Owen Staging" bot token. Never the live one.
# DISCORD_STAGING_BOT_TOKEN=
#
# Id of the TWO Staging server. Not a secret - posted in the TWO-21 thread.
# DISCORD_STAGING_GUILD_ID=
#
# Postgres URL for the staging database: the canonical `twobot_staging` on
# Coolify Postgres (TOG-7033; role `two_staging`), reached via your own bound
# environment — never copy a tunnel address from another run's logs.
# Its name must contain "staging" or "test" or the reset script will refuse
# to wipe it. See docs/STAGING.md.
# TWO_STAGING_DATABASE_URL=
#
# A second, disposable bot application invited to TWO Staging only (never the
# live guild), used solely by scripts/staging-goodbye-live-verify.ts (TOG-3467)
# to self-drive a real GuildMemberRemove while the real listener is connected.
# DISCORD_STAGING_SECOND_BOT_TOKEN=

# --- backups (production only) ----------------------------------------------
# These live in /etc/two-bot/backup.env on the host, not here. See docs/RUNBOOK.md.
#
# Where nightly dumps are written, and how many to keep.
# TWO_BACKUP_DIR=/var/backups/two-bot
# TWO_BACKUP_KEEP=14
#
# Command that copies a backup off the box. The file path is appended as the
# last argument. Unset means backups stay on the same disk as the database,
# which does not survive losing the machine.
# TWO_BACKUP_UPLOAD_CMD=/usr/local/bin/two-backup-upload
#
# Where that wrapper sends them: Cloudflare R2, bucket paperclip-backups.
# The first four are required by scripts/backup-upload-s3.ts and are refused by
# name if missing, so a half-configured destination fails the backup instead of
# writing the dump somewhere nobody looks.
#
# The two key values are secrets. They belong in /etc/two-bot/backup.env (root,
# 0600) and nowhere else — not in a ticket, a comment or a log.
# TWO_BACKUP_S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# TWO_BACKUP_S3_BUCKET=paperclip-backups
# TWO_BACKUP_S3_ACCESS_KEY_ID=
# TWO_BACKUP_S3_SECRET_ACCESS_KEY=
# TWO_BACKUP_S3_REGION=auto
# TWO_BACKUP_S3_PREFIX=
#
# Target for scripts/pg-restore.ts. Deliberately separate from TWO_DATABASE_URL
# so a restore can never hit production just because the variable was in scope.
# Point it at a scratch database.
# TWO_RESTORE_URL=
