# Copy to .env and fill in. .env is gitignored - never commit a real token.
# Production reads these from /etc/two-bot/two-bot.env instead. See docs/SECRETS.md.

# Bot token from the Discord developer application. REQUIRED.
# DISCORD_BOT_TOKEN is what the hosting environment provisions; DISCORD_TOKEN
# is accepted as an alias so older local .env files keep working.
DISCORD_BOT_TOKEN=

# Optional: restrict the bot to a single server.
DISCORD_GUILD_ID=

# Onboarding (TWO-7). Comma-separated channel ids where the welcome + game
# picker is posted. If this is empty, onboarding does not run at all - the bot
# will never guess a channel to post into. See docs/ROUTING.md.
DISCORD_LANDING_CHANNEL_IDS=

# Optional: set to 1 to run onboarding without granting any roles. The picker
# still appears and the funnel still records, but nothing is changed on the
# server. Useful for a first look on a live server.
TWO_ONBOARDING_DRY_RUN=

# Optional: where the SQLite file lives.
TWO_DB_PATH=./data/two.db

# Optional: days of silence before a member is flagged inactive.
TWO_INACTIVITY_DAYS=14

# Optional: debug | info | error
LOG_LEVEL=info

# TESTING ONLY. Points discord.js at tools/mock-discord instead of Discord.
# Must be unset in production.
# DISCORD_API_BASE=
